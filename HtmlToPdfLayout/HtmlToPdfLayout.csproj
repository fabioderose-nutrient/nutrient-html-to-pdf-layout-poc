<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HtmlToPdfLayout</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned: with 14.4.9 the HTML conversion with HtmlPageHeight = 1 (fit to content) returns InvalidParameter. -->
    <PackageReference Include="GdPicture.API" Version="14.4.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <!-- Loaded by the GdPicture HTML converter at run time. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
